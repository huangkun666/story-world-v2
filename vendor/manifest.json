  "modifications": [
    "@orama/tokenizers: optional Intl.Segmenter; fallback Unicode Han characters and letter/number words"
  ],
  "patches": [
    {
      "package": "@orama/tokenizers@3.1.18",
      "source": "dist/esm/mandarin.js",
      "originalSha256": "cfc70f3b01524fcb7aa07abd5eb1766b786b6e6d743b72e8968d5bf79e05590e",
      "bundledSourceSha256": "0c52c87faaf3a83c5a299ffe195ef5de8ee5e26eb1d6a3ab09e27a72297885d0",
      "replacements": [
        {
          "from": "const segmenter = new Intl.Segmenter(\"zh-CN\", { granularity: \"word\" });",
          "to": "const segmenter = typeof Intl.Segmenter === \"function\" ? new Intl.Segmenter(\"zh-CN\", { granularity: \"word\" }) : null;"
        },
        {
          "from": "const segments = segmenter.segment(text);",
          "to": "const segments = segmenter ? segmenter.segment(text) : Array.from(text.matchAll(/\\p{Script=Han}|[\\p{L}\\p{N}]+/gu), match => ({ segment: match[0], isWordLike: true }));"
        }
      ]
    }
  ]
